#include <iostream>
using namespace std;
int& highestMark(int marks[], int size)
{
    int highestIndex = 0;

    for (int i = 1; i < size; i++)
    {
        if (marks[i] > marks[highestIndex])
        {
            highestIndex = i;
        }
    }
    return marks[highestIndex];
}
int main()
{
    int marks[5] = {75, 88, 92, 81, 67};
    cout << "Original marks: ";

    for (int i = 0; i < 5; i++)
    {
        cout << marks[i] << " ";
    }
    cout << endl;
    int& highest = highestMark(marks, 5);
    cout << "Highest mark: " << highest << endl;
    highest += 2;
    cout << "After moderation: ";
    for (int i = 0; i < 5; i++)
    {
        cout << marks[i] << " ";
    }
    cout << endl;
    highestMark(marks, 5) = 100;
    cout << "After assigning 100: ";
    for (int i = 0; i < 5; i++)
    {
        cout << marks[i] << " ";
    }
    cout << endl;
    return 0;
}
