#include <iostream>
#include <string>
using namespace std;
class BusTicket {
    static int issued;
    static const int CAPACITY = 3;
    int seat;
    string name;
public:
    explicit BusTicket(const string& n) : seat(0), name(n) {
        if (issued < CAPACITY) {
            issued++;
            seat = issued;
        }
    }

    static int count() {
        return issued;
    }
    void print() const {
        cout << name << ": "
             << (seat ? "Seat " + to_string(seat)
                      : string("Waiting"))
             << '\n';
    }
};
int BusTicket::issued = 0;
void createTickets() {
    BusTicket trip[2] = {
        BusTicket("Ravi"),
        BusTicket("Meena")
    };
    for (const BusTicket& t : trip) {
        t.print();
    }
    cout << "Issued inside function: "
         << BusTicket::count() << '\n';
}
int main() {
    BusTicket trip[4] = {
        BusTicket("Asha"),
        BusTicket("Bala"),
        BusTicket("Chitra"),
        BusTicket("Dev")
    };

    cout << "Initial tickets:\n";
    for (const BusTicket& t : trip) {
        t.print();
    }
    cout << "Issued: " << BusTicket::count() << '\n';
    cout << "\nFirst function call:\n";
    createTickets();
    cout << "\nSecond function call:\n";
    createTickets();
    cout << "\nFinal issued count: "
         << BusTicket::count() << '\n';
    return 0;
}
